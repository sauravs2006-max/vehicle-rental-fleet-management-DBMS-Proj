# Copy to .env.local  (never commit .env.local)
DATABASE_URL=postgresql://fleet:fleet@localhost:5432/fleetdb
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=fleet_ops
# >= 32 random chars:  openssl rand -base64 48
JWT_SECRET=replace-me-with-a-long-random-string-of-32-plus-chars
# API key the telematics devices send in the x-device-key header
TELEMATICS_API_KEY=replace-me-device-key
