{
  "name": "fleet-rental",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:init": "node --env-file=.env.local scripts/init-db.mjs",
    "db:seed": "npm run db:mongo:init && node --env-file=.env.local scripts/seed.mjs",
    "db:reset": "npm run db:init && npm run db:seed",
    "typecheck": "tsc --noEmit",
    "db:mongo:init": "node --env-file=.env.local scripts/init-mongo.mjs",
    "test:mongo:validation": "node --env-file=.env.local scripts/test-mongo-validation.mjs"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "jose": "^5.9.6",
    "mongodb": "^6.10.0",
    "next": "14.2.15",
    "pg": "^8.13.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwind-merge": "^2.5.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.16.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3"
  }
}
